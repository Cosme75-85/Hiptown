// Règles de sécurité Firestore du portail Hiptown.
// Copie de référence : à coller dans la console Firebase
// (Firestore Database > Règles > Publier).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && myProfile().role == 'admin'
        && myProfile().status == 'approved';
    }

    // ── Niveaux d'administration ──────────────────────────
    // Le champ « site » d'un compte contient sa VILLE (ex. "bordeaux").
    //  - admin général : admin SANS ville → gère tous les comptes, toutes les villes
    //  - admin de ville : admin avec une ville → gère tous les comptes de sa ville
    //  - employé (adminLevel == 'site') : gère les clients de ses sites
    //    (siteIds, ex. ["nabo06"]) dans sa ville ; un client a un seul site (siteId).
    function mySite() {
      return myProfile().get('site', null);
    }

    function myLevel() {
      return myProfile().get('adminLevel', null) == 'site' ? 'site'
        : (mySite() == null ? 'general' : 'city');
    }

    function isSuperAdmin() {
      return isAdmin() && mySite() == null;
    }

    // L'admin connecté peut-il voir ce compte ?
    function canManageUser(data) {
      return isSuperAdmin()
        || (isAdmin() && myLevel() == 'city' && data.site == mySite())
        || (isAdmin() && myLevel() == 'site' && data.site == mySite()
            && data.siteId in myProfile().get('siteIds', []));
    }

    // Ce que l'admin connecté a le droit d'écrire sur un compte :
    // un admin de ville crée des admins de ville et des employés de SA ville (jamais
    // d'admin général : sa ville est imposée) ; un employé ne gère que des clients.
    function canWriteUser(data) {
      return canManageUser(data)
        && (myLevel() != 'site' || data.role != 'admin')
        && isOptionalText(data, 'siteId', 40)
        && (!('siteIds' in data) || (data.siteIds is list && data.siteIds.size() <= 30))
        && (!('adminLevel' in data) || data.adminLevel == null || data.adminLevel in ['city', 'site']);
    }

    // Un admin de ville peut envoyer un CLIENT de sa ville dans une autre ville
    // (le client sort alors de son périmètre). Jamais pour un compte admin.
    function canMoveClientToCity(before, after) {
      return isAdmin() && myLevel() == 'city'
        && before.site == mySite()
        && before.get('role', null) != 'admin' && after.get('role', null) != 'admin'
        && after.site is string && after.site.size() <= 40
        && isOptionalText(after, 'siteId', 40)
        && after.get('adminLevel', null) == null
        && after.get('siteIds', []).size() == 0;
    }

    function isApprovedRole(r) {
      return isSignedIn()
        && myProfile().role == r
        && myProfile().status == 'approved';
    }

    // Texte facultatif d'au plus max caractères
    function isShortText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // Idem, mais la valeur peut aussi être null
    function isOptionalText(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    // Champs de profil qu'un client peut modifier lui-même (page « Mon profil »)
    function isValidProfile(data) {
      return isShortText(data, 'nickname', 30)
        && isShortText(data, 'companyNameHint', 100)
        && isShortText(data, 'jobTitle', 60)
        && isShortText(data, 'city', 60)
        // Fond du portail et couleur des cases choisis dans « Paramètres » (mêmes listes que parametres.js)
        && (!('background' in data)
            || data.background in ['lavande', 'blanc', 'gris', 'mauve', 'citron', 'vert-eau', 'menthe', 'nuit', 'coworking'])
        && (!('cases' in data)
            || data.cases in ['blanc', 'gris', 'mauve', 'citron', 'vert-eau', 'menthe'])
        && (!('photo' in data) || data.photo == ''
            || (data.photo is string
                && data.photo.size() <= 150000
                && data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }

    // Comptes utilisateurs
    match /users/{userId} {
      // Un admin ne voit que les comptes de son périmètre (l'admin général voit tout)
      allow read: if isOwner(userId) || canManageUser(resource.data);

      // Inscription : compte en attente, sans rôle, sans entreprise officielle ni tuiles imposées
      // (l'e-mail est comparé en minuscules : Firebase Auth l'enregistre ainsi)
      // Un admin peut aussi créer directement un compte déjà validé, dans son périmètre.
      allow create: if canWriteUser(request.resource.data)
        || (isOwner(userId)
            && request.resource.data.status == 'pending'
            && request.resource.data.role == null
            && request.resource.data.get('companyId', null) == null
            && !request.resource.data.keys().hasAny(['extraTiles', 'hiddenTiles', 'photo', 'nickname'])
            && request.resource.data.email is string
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && isShortText(request.resource.data, 'site', 40)
            && isOptionalText(request.resource.data, 'siteId', 40)
            && !request.resource.data.keys().hasAny(['adminLevel', 'siteIds']));

      // Un admin modifie les comptes de son périmètre, sans pouvoir les en sortir.
      // Un client ne peut modifier QUE sa photo, son surnom, son entreprise déclarée, son poste, sa ville, son fond et la couleur de ses cases
      allow update: if (canWriteUser(resource.data) && canWriteUser(request.resource.data))
        || canMoveClientToCity(resource.data, request.resource.data)
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nickname', 'photo', 'companyNameHint', 'jobTitle', 'city', 'background', 'cases'])
            && isValidProfile(request.resource.data));

      allow delete: if canWriteUser(resource.data);
    }

    // Entreprises (coworking)
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Accueil visiteurs (page publique Hiptown-Accueil-1) ──
    // Compte coworking validé, rattaché à cette entreprise
    function isCompanyMember(companyId) {
      return isApprovedRole('coworking') && myProfile().get('companyId', null) == companyId;
    }

    // Logo de la case : image JPEG ou PNG réduite dans le navigateur (accueil-fiche.js)
    function isValidLogo(data) {
      return !('logo' in data) || data.logo == ''
        || (data.logo is string
            && data.logo.size() <= 150000
            && data.logo.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+$'));
    }

    // people : personnes de l'entreprise affichées sur la page ({id, name, role}, au plus 30) ;
    // pin : code à 4 chiffres facultatif pour voir ces personnes ;
    // visible : l'entreprise du portail a choisi d'apparaître sur la page (les cases « manual » apparaissent toujours)
    function isValidAccueilCard(data) {
      return data.keys().hasOnly(['name', 'city', 'siteId', 'logo', 'manual', 'people', 'pin', 'visible', 'updatedAt'])
        && (!('visible' in data) || data.visible is bool)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.city is string && data.city.size() > 0 && data.city.size() <= 40
        && isOptionalText(data, 'siteId', 40)
        && (!('manual' in data) || data.manual is bool)
        && (!('people' in data) || (data.people is list && data.people.size() <= 30))
        && (!('pin' in data) || data.pin == '' || (data.pin is string && data.pin.matches('^[0-9]{4}$')))
        && isValidLogo(data);
    }

    // L'équipe d'une ville gère les cases de sa ville (l'admin général, toutes les villes)
    function canManageAccueilCity(city) {
      return isSuperAdmin() || (isAdmin() && city != null && city == mySite());
    }

    function accueilCityOf(id) {
      return get(/databases/$(database)/documents/accueil/$(id)).data.get('city', null);
    }

    // Case d'une entreprise : nom, ville, site et logo, lisibles par tous (page sans connexion).
    //  - entreprise du portail (id = companyId) : créée par l'équipe de sa ville, ou par un salarié
    //    avec le nom officiel, sa ville et son site ; ensuite, un salarié ne change que le logo
    //    et le choix d'apparaître sur la page (visible) ;
    //  - case ajoutée à la main (id « m-… ») : l'équipe de la ville l'ajoute, la modifie, la retire.
    match /accueil/{id} {
      allow read: if true;
      allow create: if isValidAccueilCard(request.resource.data)
        && (canManageAccueilCity(request.resource.data.city)
            || (isCompanyMember(id)
                && request.resource.data.get('manual', false) == false
                && request.resource.data.name == get(/databases/$(database)/documents/companies/$(id)).data.name
                && request.resource.data.city == myProfile().get('site', null)
                && request.resource.data.get('siteId', null) == myProfile().get('siteId', null)));
      allow update: if isValidAccueilCard(request.resource.data)
        && ((canManageAccueilCity(resource.data.get('city', null)) && canManageAccueilCity(request.resource.data.city))
            || (isCompanyMember(id)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logo', 'visible', 'updatedAt'])));
      allow delete: if canManageAccueilCity(resource.data.get('city', null));
    }

    // Adresses qui reçoivent les visites (email : l'entreprise ; people : {id de la personne: e-mail}) : jamais publiques, lue par Apps Script (Accueil.gs)
    // avec le compte de service, au moment d'envoyer l'e-mail. La case doit exister (sa ville décide).
    function canManageAccueilEmail(id) {
      return isCompanyMember(id)
        || (exists(/databases/$(database)/documents/accueil/$(id)) && canManageAccueilCity(accueilCityOf(id)));
    }

    match /accueilEmails/{id} {
      allow read, delete: if canManageAccueilEmail(id);
      allow create, update: if canManageAccueilEmail(id)
        && request.resource.data.keys().hasOnly(['email', 'people', 'updatedAt'])
        && (!('people' in request.resource.data)
            || (request.resource.data.people is map && request.resource.data.people.size() <= 30))
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && (request.resource.data.email == ''
            || request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    // Reservations de salles
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isApprovedRole('salle') || isApprovedRole('coworking') || isAdmin();
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Messagerie (messagerie.js) ─────────────────────────
    // Une conversation par client : conversations/{uid du client}, messages dans
    // conversations/{uid}/messages. L'équipe la voit selon le même périmètre que
    // le compte du client (canManageUser) : ville et site sont recopiés de la
    // fiche du client à chacun de ses messages.
    function isClientAccount() {
      return isApprovedRole('salle') || isApprovedRole('coworking');
    }

    function isMessageText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Nombre de messages non lus (pastille) : entier raisonnable
    function isUnreadCount(data, field, min) {
      return data.get(field, 0) is int && data.get(field, 0) >= min && data.get(field, 0) <= 9999;
    }

    // Conversation écrite par le client lui-même, avec un nouveau message
    function isValidClientConversation(uid, data) {
      return data.keys().hasOnly(['uid', 'site', 'siteId', 'clientName', 'clientCompany', 'clientEmail',
                                  'clientRole', 'lastText', 'lastFrom', 'lastAt', 'unreadTeam', 'unreadClient',
                                  'unreadTeamCount', 'unreadClientCount'])
        && data.uid == uid
        && data.get('site', null) == mySite()
        && data.get('siteId', null) == myProfile().get('siteId', null)
        && data.clientRole == myProfile().role
        && isShortText(data, 'clientName', 120)
        && isShortText(data, 'clientCompany', 120)
        && isShortText(data, 'clientEmail', 120)
        && isMessageText(data.lastText, 200)
        && data.lastFrom == 'client'
        && data.lastAt == request.time
        && data.unreadTeam == true
        && data.unreadClient == false
        && isUnreadCount(data, 'unreadTeamCount', 0)
        && data.get('unreadClientCount', 0) == 0;
    }

    match /conversations/{uid} {
      allow read: if isOwner(uid) || canManageUser(resource.data);

      allow create: if isOwner(uid) && isClientAccount()
        && isValidClientConversation(uid, request.resource.data);

      allow update: if
        // Client : nouveau message, ou messages de l'équipe marqués comme lus
        (isOwner(uid) && isClientAccount()
          && (isValidClientConversation(uid, request.resource.data)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadClient', 'unreadClientCount'])
                  && request.resource.data.unreadClient == false
                  && request.resource.data.get('unreadClientCount', 0) == 0)))
        // Équipe : réponse, ou messages du client marqués comme lus
        || (canManageUser(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastText', 'lastFrom', 'lastAt', 'unreadTeam', 'unreadClient', 'unreadTeamCount', 'unreadClientCount'])
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadTeam', 'unreadTeamCount'])
               && request.resource.data.unreadTeam == false
               && request.resource.data.get('unreadTeamCount', 0) == 0)
              || (isMessageText(request.resource.data.lastText, 200)
                  && request.resource.data.lastFrom == 'team'
                  && request.resource.data.lastAt == request.time
                  && request.resource.data.unreadTeam == false
                  && request.resource.data.get('unreadTeamCount', 0) == 0
                  && request.resource.data.unreadClient == true
                  && isUnreadCount(request.resource.data, 'unreadClientCount', 0))));

      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(uid)).data;
        }

        function isValidMessage(from) {
          return request.resource.data.keys().hasOnly(['from', 'authorUid', 'authorName', 'text', 'createdAt'])
            && request.resource.data.from == from
            && request.resource.data.authorUid == request.auth.uid
            && isShortText(request.resource.data, 'authorName', 120)
            && isMessageText(request.resource.data.text, 2000)
            && request.resource.data.createdAt == request.time;
        }

        allow read: if isOwner(uid) || canManageUser(conversation());

        // Le client écrit dans SA conversation (elle est créée dans le même envoi) ;
        // l'équipe répond dans les conversations de son périmètre.
        allow create: if (isOwner(uid) && isClientAccount() && isValidMessage('client'))
          || (canManageUser(conversation()) && isValidMessage('team'));

        // Un message envoyé ne se modifie pas et ne se supprime pas
        allow update, delete: if false;
      }
    }

    // Discussions de groupe (messagerie.js) :
    //  - channels/team-{ville} : l'équipe Hiptown de la ville (l'admin général les voit toutes)
    //  - channels/company-{id} : les coworkers d'une entreprise (l'équipe Hiptown n'y a pas accès)
    function isChannelMember(channelId) {
      return (channelId.matches('team-.+') && isAdmin()
              && (isSuperAdmin() || channelId == 'team-' + mySite()))
        || (channelId.matches('company-.+') && isApprovedRole('coworking')
            && myProfile().get('companyId', null) is string
            && channelId == 'company-' + myProfile().companyId);
    }

    match /channels/{channelId} {
      allow read: if isChannelMember(channelId);

      // Aperçu du dernier message, écrit avec chaque message
      allow create, update: if isChannelMember(channelId)
        && request.resource.data.keys().hasOnly(['lastText', 'lastAt', 'lastAuthorUid', 'lastAuthorName'])
        && isMessageText(request.resource.data.lastText, 200)
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastAuthorUid == request.auth.uid
        && isShortText(request.resource.data, 'lastAuthorName', 120);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId)
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && isShortText(request.resource.data, 'authorName', 120)
          && isMessageText(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Appareils qui reçoivent les notifications de la messagerie (messagerie.js).
    // Seul le compte lui-même les voit ; l'outil de réservation les lit avec le compte
    // de service Firebase pour envoyer les notifications (reservation/Messagerie.gs).
    match /pushTokens/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'updatedAt'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.updatedAt == request.time;
    }

    // Statistiques de la phase de test (statistiques.js) : nombre de clics d'un client
    // sur chaque case du portail. Le client n'écrit que sa propre fiche, avec la ville,
    // le site et l'espace de son compte ; l'équipe la lit dans son périmètre ;
    // seul l'admin général remet les compteurs à zéro.
    match /clickStats/{uid} {
      allow read: if canManageUser(resource.data);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['space', 'site', 'siteId', 'counts', 'updatedAt'])
        && request.resource.data.space in ['salle', 'coworking']
        && isApprovedRole(request.resource.data.space)
        && request.resource.data.site == myProfile().get('site', null)
        && request.resource.data.siteId == myProfile().get('siteId', null)
        && request.resource.data.counts is map
        && request.resource.data.counts.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    // Commandes petit-dejeuner
    match /breakfastOrders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
